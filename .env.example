# =============================================================================
# Custom Home Network — environment variables
# Copy to .env / Railway. Never commit real secrets.
# =============================================================================

# --- Shadcnspace Pro (CLI install of premium blocks) ---
EMAIL=
LICENSE_KEY=
# Optional aliases (same values as above if preferred)
SHADCNSPACE_EMAIL=
SHADCNSPACE_LICENSE_KEY=

# --- Form webhooks (POST JSON from /api/submit) ---
# When empty: forms still succeed in dev; payload is logged server-side.
# When set: payload is forwarded as { type, payload, receivedAt, source }.
#
# schedule  → contact / buyers consultation form
# newsletter → footer + insights signup
# partner   → /partners application form
WEBHOOK_URL_SCHEDULE=
WEBHOOK_URL_NEWSLETTER=
WEBHOOK_URL_PARTNER=

# --- Sentry (@sentry/nextjs) — optional until production DSN exists ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Runtime (Docker / Railway) ---
# PORT=8080
# NODE_ENV=production
# HOSTNAME=0.0.0.0
